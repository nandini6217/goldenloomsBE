NODE_ENV=development
PORT=4000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=some_secret_min_32_characters_long

ADMIN_EMAIL=admin@goldenlooms.com
ADMIN_PASSWORD=ChangeMe123!

# Frontend / Backend URLs (for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Google OAuth (optional; for Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (Dashboard: https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_webhook_settings

# Shiprocket (shipping – order is created and courier assigned after payment is captured)
# Create an API user in Shiprocket: Settings > API. Use that email/password here.
# For tracking updates: Settings > API > Webhooks > set URL to: {BACKEND_URL}/api/webhooks/shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# AWS S3 (for product image uploads; bucket should allow public read for product images)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
